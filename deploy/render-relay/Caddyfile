(northflank_upstream) {
	reverse_proxy {$ORBITAL_API_ORIGIN} {
		header_up Host {upstream_hostport}
	}
}

:{$PORT:10000} {
	@read {
		method GET
		path /healthz /ws
	}
	@rpc {
		method POST OPTIONS
		path /orbital.scores.v1.LeaderboardService/* /orbital.scores.v1.ResultsService/*
	}

	handle @read {
		import northflank_upstream
	}
	handle @rpc {
		import northflank_upstream
	}
	handle {
		respond 404
	}
}
